# Copy this file to .env.local and fill in real values.
# Get them from: Supabase Dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server-only. Required for the admin panel's create/delete/reset-student actions
# (Supabase Auth only allows service-role clients to manage users).
# NEVER expose this to the browser and never commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server-only. Required for the AI assistant (Ask AI chat room) and the AI quiz
# generator. Get a key from https://build.nvidia.com — the app talks to NVIDIA
# NIM's OpenAI-compatible endpoint.
NVIDIA_API_KEY=your-nvidia-nim-api-key
# Optional override; defaults to https://integrate.api.nvidia.com/v1
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Server-only. Optional — adds a live-web search tool to the AI assistant.
# Get a free key (1,000 searches/month, no card) at https://tavily.com.
# Without it the AI says it has no internet access.
TAVILY_API_KEY=your-tavily-api-key

# Used only by scripts/seed-demo.mjs (admin login for seeding demo material).
ADMIN_EMAIL=admin@ithub11.in
ADMIN_PASSWORD=your-admin-password